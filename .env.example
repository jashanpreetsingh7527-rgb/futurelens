# ---------------------------------------------------------------
# Copy this file to .env before first run.
# ---------------------------------------------------------------

# Supabase Credentials (from your Supabase Project Settings -> API)
# Both are free and take 1 minute to generate on supabase.com
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# The first Super Admin. Used once, by `node setup.js`.
# Delete ADMIN_PASSWORD from this file as soon as setup has run.
ADMIN_NAME="Club President"
ADMIN_EMAIL=president@futurelens.club
ADMIN_PASSWORD=ChangeThisNow123

PORT=3000

# Set to false only when testing over plain http://localhost.
# In production on Vercel over HTTPS, remove or set to true.
SECURE_COOKIES=false

# Set to true when running on Vercel or behind a reverse proxy.
TRUST_PROXY=true

SESSION_HOURS=8
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

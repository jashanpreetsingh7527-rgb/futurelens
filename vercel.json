{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.js" },
    { "src": "/uploads/(.*)", "dest": "/api/index.js" },
    { "src": "/admin$", "dest": "/public/admin/login.html" },
    { "src": "/admin/$", "dest": "/public/admin/login.html" },
    { "src": "/admin/(.*)", "dest": "/public/admin/$1" },
    { "src": "/assets/(.*)", "dest": "/public/assets/$1" },
    { "src": "/page.html", "dest": "/public/page.html" },
    { "src": "/(favicon\\.png|robots\\.txt)", "dest": "/public/$1" },
    { "src": "/(.*\\.html)$", "dest": "/public/$1" },
    { "src": "^/$", "dest": "/public/index.html" },
    { "src": "/(.*)", "dest": "/public/index.html" }
  ]
}
